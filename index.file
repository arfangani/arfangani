<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arfan Gani | IT Student - Portfolio</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: { extend: { fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] } } }
    }
  </script>

  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body { background-color: #07090e; color: #e2e8f0; font-family: 'Inter', system-ui, sans-serif; }
    .bg-radial-grid { background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 24px 24px; }
    .text-gradient-cyan { background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #090d16; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
  </style>
</head>
<body class="selection:bg-cyan-500 selection:text-white min-h-screen overflow-x-hidden">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // =====================================================
    // DATA — edit everything marked TODO / [brackets]
    // =====================================================
    const personalInfo = {
      name: "Arfan Gani",
      initials: "AG",
      role: "IT Student",
      location: "Johor, Malaysia",
      status: "Currently studying",
      bio: "I'm studying for a Diploma in Information Technology at Universiti Tun Hussein Onn Malaysia (UTHM). I enjoy learning how systems work and picking up new tools. Outside class, I do photography, videography and video editing.",
      email: "arfann0840@gmail.com",
      github: "https://github.com/arfangani",
      linkedin: "https://www.linkedin.com/in/arfan-undefined-10b4a444a/",
      stats: [
        { label: "Programme", value: "Dip. IT" },
        { label: "University", value: "UTHM" },
        { label: "Started", value: "2026" },
        { label: "Graduating", value: "2029" },
      ]
    };

    const skillsData = [
      { title: "Programming", note: "Languages I'm learning and using", items: ["Python", "C++", "Java"] },
      { title: "Creative & Media", note: "What I do beyond the classroom", items: ["Photography", "Videography", "Video Editing", "DaVinci Resolve"] },
    ];
    const softSkills = ["Problem solving", "Teamwork", "Willingness to learn", "Clear communication"];

    const timelineData = [
      {
        title: "Diploma in Information Technology",
        org: "Universiti Tun Hussein Onn Malaysia (UTHM)",
        period: "2026 – 2029",
        highlights: ["Currently studying core IT topics at UTHM."],
        modulesTitle: "Semester 1, 2026/2027",
        modules: [
          { code: "DAT10203", name: "Discrete Mathematics" },
          { code: "DAT10703", name: "Computer Architecture" },
          { code: "DAT10903", name: "Operating Systems" },
          { code: "DAT11003", name: "Data Communication & Networking" },
          { code: "DAT11103", name: "Algorithm Design" },
          { code: "UHB13002", name: "Introduction to English Communication" },
          { code: "UQI10402", name: "Introduction to Islamic Studies" },
          { code: "UQW10501", name: "Techno-Entrepreneurship I" },
        ]
      },
    ];

    const terminalCommands = {
      help: "Available commands:\n  about     - Quick introduction\n  skills    - What I can do\n  contact   - How to reach me\n  clear     - Clear the terminal",
      about: "Arfan Gani | IT Student\nDiploma in IT at UTHM (2026-2029), from Johor, Malaysia. Codes in Python, C++ and Java, and does photography and video editing.",
      skills: "Programming: Python, C++, Java\nCreative: photography, videography, video editing (DaVinci Resolve).",
      contact: "Email: arfann0840@gmail.com\nGitHub: github.com/arfangani\nLinkedIn: see the Contact section",
    };

    // =====================================================
    // COMPONENTS
    // =====================================================
    function Navbar() {
      const [scrolled, setScrolled] = useState(false);
      const [open, setOpen] = useState(false);
      useEffect(() => {
        const h = () => setScrolled(window.scrollY > 20);
        window.addEventListener('scroll', h);
        return () => window.removeEventListener('scroll', h);
      }, []);
      const links = ["About", "Photos", "Skills", "Education", "Terminal", "Contact"];
      return (
        <header className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${scrolled ? 'bg-[#07090e]/85 backdrop-blur-md border-b border-slate-800/80 py-3' : 'bg-transparent py-5'}`}>
          <div className="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between">
            <a href="#" className="flex items-center gap-3 group">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 p-[1.5px] group-hover:scale-105 transition-transform">
                <div className="w-full h-full bg-[#0b0f19] rounded-[10px] flex items-center justify-center font-mono font-bold text-sky-400 text-sm">
                  {personalInfo.initials}
                </div>
              </div>
              <div>
                <span className="font-semibold text-slate-100 text-base tracking-tight block">{personalInfo.name}</span>
                <span className="text-xs text-slate-400 font-mono hidden sm:block">it-student</span>
              </div>
            </a>
            <nav className="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-full border border-slate-800/80">
              {links.map(l => (
                <a key={l} href={`#${l.toLowerCase()}`} className="px-3.5 py-1.5 text-sm font-medium text-slate-300 hover:text-sky-400 hover:bg-slate-800/50 rounded-full transition-all">{l}</a>
              ))}
            </nav>
            <a href="#contact" className="hidden md:inline-block text-xs font-semibold uppercase tracking-wider px-4 py-2 rounded-lg bg-gradient-to-r from-sky-500 to-blue-600 text-white">Let's Talk</a>
            <button onClick={() => setOpen(!open)} aria-label="Toggle menu" className="md:hidden p-2 text-slate-300 hover:text-white">☰</button>
          </div>
          {open && (
            <div className="md:hidden bg-[#0a0e1a] border-b border-slate-800 px-6 py-6 flex flex-col gap-3">
              {links.map(l => (
                <a key={l} href={`#${l.toLowerCase()}`} onClick={() => setOpen(false)} className="text-base text-slate-300 hover:text-sky-400 py-1">{l}</a>
              ))}
            </div>
          )}
        </header>
      );
    }

    function Hero() {
      const tech = ["Python", "C++", "Java", "Photography", "Videography", "Video Editing", "DaVinci Resolve"];
      return (
        <section id="about" className="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
          <div className="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-gradient-to-tr from-sky-600/20 via-indigo-600/15 to-transparent blur-3xl pointer-events-none rounded-full" />
          <div className="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
            <div className="flex flex-col items-start max-w-3xl">
              <div className="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/60 mb-6">
                <span className="relative flex h-2.5 w-2.5">
                  <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                </span>
                <span className="text-xs font-medium text-slate-300">{personalInfo.status}</span>
              </div>
              <h1 className="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-[1.1]">
                Learning to build <span className="text-gradient-cyan">useful technology.</span>
              </h1>
              <p className="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed">
                Hi, I'm <strong className="text-white font-semibold">{personalInfo.name}</strong>, an {personalInfo.role}. {personalInfo.bio}
              </p>
              <div className="flex flex-wrap items-center gap-4 mb-14">
                <a href="#photos" className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 text-white font-semibold text-sm shadow-lg shadow-sky-500/20 hover:-translate-y-0.5 transition-all">
                  <span>See Photos</span><span>↗</span>
                </a>
                <a href="#terminal" className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:border-sky-500/50 text-slate-200 font-semibold text-sm hover:-translate-y-0.5 transition-all">
                  <span className="text-sky-400 font-mono">&gt;_</span><span>Try the Terminal</span>
                </a>
                <a href="#contact" className="text-slate-400 hover:text-slate-100 font-medium text-sm py-3.5 px-4">Get in touch &rarr;</a>
              </div>
              <div className="w-full pt-8 border-t border-slate-800/80">
                <p className="text-xs font-mono uppercase tracking-widest text-slate-400 mb-3">What I do</p>
                <div className="flex flex-wrap gap-2">
                  {tech.map(t => <span key={t} className="px-3 py-1 rounded-md bg-slate-900/80 border border-slate-800 text-xs font-mono text-slate-300">{t}</span>)}
                </div>
              </div>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full mt-12">
                {personalInfo.stats.map((s, i) => (
                  <div key={i} className="p-4 rounded-xl bg-slate-900/40 border border-slate-800/60">
                    <div className="text-2xl sm:text-3xl font-extrabold text-gradient-cyan mb-1 font-mono">{s.value}</div>
                    <div className="text-xs text-slate-400 font-medium">{s.label}</div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </section>
      );
    }

    function Photos() {
      const photos = [
        { src: "data:image/png;base64,", alt: "Arfan Gani standing on stone steps in the afternoon sun", caption: "Golden hour", note: "📍 Thailand. A memory from a trip, caught in the last of the afternoon sun." },
        { src: "data:image/png;base64,", alt: "Arfan Gani on a rooftop at night", caption: "Night out", note: "📍 Genting Highlands. A cool evening above the clouds." },
      ];
      return (
        <section id="photos" className="py-24">
          <div className="max-w-5xl mx-auto px-4 sm:px-6">
            <div className="text-center max-w-2xl mx-auto mb-12">
              <div className="inline-flex px-3 py-1 rounded-md bg-sky-950/60 border border-sky-800/40 text-sky-400 text-xs font-mono mb-3">PHOTOS</div>
              <h2 className="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">A Bit About Me</h2>
              <p className="text-slate-400 mt-2">Behind the screen, this is me.</p>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
              {photos.map((p, i) => (
                <figure key={i} className="group relative rounded-2xl overflow-hidden bg-slate-900/50 border border-slate-800/80 hover:border-sky-500/40 transition-all">
                  <img
                    src={p.src}
                    alt={p.alt}
                    className="w-full aspect-[3/4] object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <figcaption className="absolute bottom-0 left-0 right-0 px-4 pt-10 pb-4 bg-gradient-to-t from-slate-950/95 via-slate-950/70 to-transparent"><span className="block text-sm text-white font-semibold">{p.caption}</span><span className="block text-xs text-slate-300 mt-1 leading-snug">{p.note}</span></figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      );
    }

    function Skills() {
      return (
        <section id="skills" className="py-24 bg-slate-950/40 border-y border-slate-800/60">
          <div className="max-w-6xl mx-auto px-4 sm:px-6">
            <div className="text-center max-w-2xl mx-auto mb-16">
              <div className="inline-flex px-3 py-1 rounded-md bg-sky-950/60 border border-sky-800/40 text-sky-400 text-xs font-mono mb-3">SKILLS</div>
              <h2 className="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">What I Know</h2>
              <p className="text-slate-400 mt-2">The coding and creative skills I've picked up so far.</p>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
              {skillsData.map((g, i) => (
                <div key={i} className="rounded-2xl p-6 bg-slate-900/40 border border-slate-800/80">
                  <h3 className="text-lg font-bold text-white mb-1">{g.title}</h3>
                  <p className="text-xs text-slate-400 mb-6 pb-4 border-b border-slate-800">{g.note}</p>
                  <div className="flex flex-wrap gap-2">
                    {g.items.map((s, k) => <span key={k} className="px-3 py-1.5 text-sm rounded-lg bg-slate-900/60 border border-slate-800/50 text-slate-200">{s}</span>)}
                  </div>
                </div>
              ))}
            </div>
            <div className="mt-8 p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
              <span className="text-sm font-semibold text-slate-200">Soft skills:</span>
              <div className="flex flex-wrap gap-2">
                {softSkills.map((p, i) => <span key={i} className="px-3 py-1 text-xs font-mono rounded-full bg-slate-800/80 border border-slate-700/60 text-slate-300">✓ {p}</span>)}
              </div>
            </div>
          </div>
        </section>
      );
    }

    function Education() {
      return (
        <section id="education" className="py-24">
          <div className="max-w-4xl mx-auto px-4 sm:px-6">
            <div className="mb-16">
              <div className="inline-flex px-3 py-1 rounded-md bg-sky-950/60 border border-sky-800/40 text-sky-400 text-xs font-mono mb-3">BACKGROUND</div>
              <h2 className="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Education & Activities</h2>
            </div>
            <div className="relative pl-6 sm:pl-8 border-l border-slate-800 space-y-12">
              {timelineData.map((item, idx) => (
                <div key={idx} className="relative group">
                  <div className="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-slate-950 border-2 border-sky-400 group-hover:scale-125 transition-all" />
                  <div className="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80">
                    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-3">
                      <div>
                        <h3 className="text-xl font-bold text-white">{item.title}</h3>
                        <div className="text-sm font-medium text-sky-400">{item.org}</div>
                      </div>
                      <span className="text-xs font-mono text-slate-300 px-2.5 py-1 rounded bg-slate-800 border border-slate-700/60 w-fit">{item.period}</span>
                    </div>
                    <ul className="space-y-2 mt-4">
                      {item.highlights.map((h, i) => (
                        <li key={i} className="text-sm text-slate-300 flex items-start gap-2.5"><span className="text-sky-400 font-bold">•</span><span>{h}</span></li>
                      ))}
                    </ul>
                    {item.modules && (
                      <div className="mt-6 pt-5 border-t border-slate-800/80">
                        <p className="text-xs font-mono uppercase tracking-widest text-slate-400 mb-3">{item.modulesTitle}</p>
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {item.modules.map((m, k) => (
                            <div key={k} className="flex items-center gap-3 px-3 py-2 rounded-lg bg-slate-900/60 border border-slate-800/50">
                              <span className="text-[11px] font-mono text-sky-400 shrink-0">{m.code}</span>
                              <span className="text-sm text-slate-200">{m.name}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    }

    function TerminalWidget() {
      const [inputVal, setInputVal] = useState('');
      const [history, setHistory] = useState([
        { type: 'system', text: "Portfolio shell v1.0\nType 'help' to see available commands, or use the buttons below." },
      ]);
      const bottomRef = useRef(null);

      useEffect(() => {
        if (bottomRef.current) bottomRef.current.scrollIntoView({ block: 'nearest' });
      }, [history]);

      const run = (cmdStr) => {
        const t = cmdStr.trim().toLowerCase();
        if (!t) return;
        if (t === 'clear') { setHistory([]); setInputVal(''); return; }
        const out = terminalCommands[t] || `command not found: "${t}". Type "help" for a list of commands.`;
        setHistory(prev => [...prev, { type: 'user', text: cmdStr }, { type: 'response', text: out }]);
        setInputVal('');
      };
      const quick = ['help', 'about', 'skills', 'contact', 'clear'];

      return (
        <section id="terminal" className="py-24 bg-slate-950/60 border-t border-slate-800/60">
          <div className="max-w-4xl mx-auto px-4 sm:px-6">
            <div className="text-center max-w-xl mx-auto mb-10">
              <div className="inline-flex px-3 py-1 rounded-md bg-sky-950/60 border border-sky-800/40 text-sky-400 text-xs font-mono mb-3">INTERACTIVE</div>
              <h2 className="text-3xl font-extrabold text-white">Terminal</h2>
              <p className="text-slate-400 text-sm mt-2">Type a command, or click one below.</p>
            </div>
            <div className="rounded-2xl bg-[#080c14] border border-slate-800 shadow-2xl overflow-hidden">
              <div className="px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center gap-2">
                <span className="w-3 h-3 rounded-full bg-rose-500/80" />
                <span className="w-3 h-3 rounded-full bg-amber-500/80" />
                <span className="w-3 h-3 rounded-full bg-emerald-500/80" />
                <span className="ml-2 text-xs font-mono text-slate-400">guest@portfolio</span>
              </div>
              <div className="px-4 py-2 bg-slate-900/40 border-b border-slate-800 flex flex-wrap gap-2">
                <span className="text-[11px] font-mono text-slate-400 self-center">Try:</span>
                {quick.map(c => (
                  <button key={c} onClick={() => run(c)} className="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 hover:bg-sky-950 hover:text-sky-300 text-slate-300 border border-slate-700/60">{c}</button>
                ))}
              </div>
              <div className="p-5 font-mono text-xs sm:text-sm min-h-[240px] max-h-[360px] overflow-y-auto space-y-3">
                {history.map((h, i) => (
                  <div key={i}>
                    {h.type === 'user' && <div><span className="text-slate-400">guest@portfolio:~$ </span><span className="text-white">{h.text}</span></div>}
                    {h.type === 'response' && <pre className="text-slate-300 whitespace-pre-wrap pl-4 border-l-2 border-slate-800 mt-1 font-mono text-xs">{h.text}</pre>}
                    {h.type === 'system' && <pre className="text-slate-400 whitespace-pre-wrap text-xs">{h.text}</pre>}
                  </div>
                ))}
                <div className="flex items-center gap-2 pt-1">
                  <span className="text-slate-400">guest@portfolio:~$ </span>
                  <input
                    type="text" value={inputVal}
                    onChange={e => setInputVal(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && run(inputVal)}
                    placeholder="type a command..."
                    aria-label="Terminal command"
                    className="flex-1 bg-transparent outline-none text-white font-mono text-xs sm:text-sm"
                  />
                </div>
                <div ref={bottomRef} />
              </div>
            </div>
          </div>
        </section>
      );
    }

    function Contact() {
      const [copied, setCopied] = useState(false);
      const [form, setForm] = useState({ name: '', email: '', message: '' });

      const copyEmail = () => {
        try { navigator.clipboard.writeText(personalInfo.email); } catch (e) {}
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
      };

      // Opens the visitor's email app with the message pre-filled (no backend needed).
      const submit = (e) => {
        e.preventDefault();
        const subject = encodeURIComponent(`Portfolio message from ${form.name}`);
        const body = encodeURIComponent(`${form.message}\n\n— ${form.name} (${form.email})`);
        window.location.href = `mailto:${personalInfo.email}?subject=${subject}&body=${body}`;
      };

      const field = "w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-sky-500 outline-none";
      return (
        <section id="contact" className="py-24">
          <div className="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12">
            <div className="lg:col-span-5 flex flex-col justify-between">
              <div>
                <div className="inline-flex px-3 py-1 rounded-md bg-sky-950/60 border border-sky-800/40 text-sky-400 text-xs font-mono mb-3">CONTACT</div>
                <h2 className="text-3xl sm:text-4xl font-extrabold text-white mb-4">Let's connect.</h2>
                <p className="text-slate-300 text-base mb-8">I'm happy to chat about projects, learning IT, or anything tech-related. Feel free to say hi.</p>
                <div className="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 mb-6">
                  <span className="text-xs font-mono text-slate-400 block mb-1">Email</span>
                  <div className="flex items-center justify-between gap-2">
                    <span className="text-sm font-mono text-white break-all">{personalInfo.email}</span>
                    <button onClick={copyEmail} className="px-3 py-1 rounded-lg bg-slate-800 text-slate-200 text-xs font-mono shrink-0">{copied ? '✓ Copied' : 'Copy'}</button>
                  </div>
                </div>
                <div className="space-y-2 text-sm text-slate-400 font-mono">
                  <div>📍 Location: <span className="text-slate-200">{personalInfo.location}</span></div>
                  <div>⚡ Status: <span className="text-emerald-400 font-semibold">{personalInfo.status}</span></div>
                </div>
              </div>
              <div className="pt-6 border-t border-slate-800/80 mt-8 flex gap-4">
                <a href={personalInfo.github} target="_blank" rel="noreferrer" className="text-slate-400 hover:text-white">GitHub ↗</a>
                <a href={personalInfo.linkedin} target="_blank" rel="noreferrer" className="text-slate-400 hover:text-white">LinkedIn ↗</a>
              </div>
            </div>
            <div className="lg:col-span-7">
              <form onSubmit={submit} className="p-8 rounded-2xl bg-slate-900/40 border border-slate-800/90 space-y-4">
                <h3 className="text-lg font-bold text-white mb-2">Send a message</h3>
                <div><label className="block text-xs font-mono text-slate-400 mb-1">Name</label>
                  <input type="text" required value={form.name} onChange={e => setForm({ ...form, name: e.target.value })} className={field} /></div>
                <div><label className="block text-xs font-mono text-slate-400 mb-1">Email</label>
                  <input type="email" required value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} className={field} /></div>
                <div><label className="block text-xs font-mono text-slate-400 mb-1">Message</label>
                  <textarea rows={4} required value={form.message} onChange={e => setForm({ ...form, message: e.target.value })} className={field + " resize-none"} /></div>
                <button type="submit" className="w-full py-3 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 text-white font-semibold text-sm shadow-lg shadow-sky-500/20 hover:opacity-95">Open in Email App &rarr;</button>
              </form>
            </div>
          </div>
        </section>
      );
    }

    function Footer() {
      return (
        <footer className="py-12 border-t border-slate-800/80 bg-[#06080e]">
          <div className="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <span className="text-sm text-slate-400"><span className="font-mono text-sky-400 font-bold">&lt;/&gt;</span> {personalInfo.name} — {personalInfo.role}</span>
            <span className="text-xs text-slate-500">© {new Date().getFullYear()} Built with React & Tailwind CSS.</span>
          </div>
        </footer>
      );
    }

    function App() {
      return (
        <div className="min-h-screen bg-[#07090e] text-slate-100 relative">
          <div className="fixed inset-0 bg-radial-grid opacity-30 pointer-events-none" />
          <Navbar />
          <main className="relative z-10">
            <Hero />
            <Photos />
            <Skills />
            <Education />
            <TerminalWidget />
            <Contact />
          </main>
          <Footer />
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
